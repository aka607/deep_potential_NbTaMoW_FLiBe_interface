# Interface between (100)-NbTaMoW metal slab and 66-33% LiF-BeF2 salt overlay at 800 K. 

units           metal
boundary        p p p
atom_style      atomic

neighbor        1.0 bin
neigh_modify    every 10 delay 0 check no

read_data	FLiBe_NbTaMoW.data

pair_style	deepmd graph.pb
pair_coeff	* *

velocity        all create 800.0 23456789
fix             1 all nvt temp 800.0 800.0 0.1
timestep        0.001

thermo_style    custom step pe ke etotal temp press vol
thermo          100
dump		1 all custom 100 FLiBe_NbTaMoW.dump id type x y z 

run             10000
